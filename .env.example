# ─── Meru Posture Monitor Backend Configuration ──────────────────────────────
# Copy this file to .env and configure your environment credentials.

# Google Gemini API Key (Required for AI Ergonomics Coach)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local SQLite Database Path (Used for local persistence)
DATABASE_PATH=sessions.db

# Supabase Postgres Connection Pooler URL (For cloud persistence)
# Example: postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase Auth Configuration
# Project settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Service role key (Backend / Seed script ONLY - NEVER commit or expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret from Supabase Project Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail SMTP Configuration (For Weekly Posture Digest)
# Requires Google 2-Step Verification + App Password
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Scheduled Weekly Digest Cron (e.g., 'mon 08:00')
DIGEST_CRON=mon 08:00
